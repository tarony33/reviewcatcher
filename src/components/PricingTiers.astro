---
import { siteConfig } from "../config/site.config";

const tickSvg =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>';

// Price data for the monthly/annual toggle script — non-enquire tiers only
// (Enterprise has no fixed price to toggle between).
const tierPriceData = Object.fromEntries(
  siteConfig.pricing.tiers
    .filter((t) => !t.enquireOnly)
    .map((t) => [t.id, { monthly: t.monthlyEUR, annual: t.annualEUR }])
);
---

<section class="offer" id="offer">
  <div class="wrap">
    <div class="sec-head center">
      <span class="eyebrow">Simple pricing</span>
      <h2>Pick the level that fits. Move up any time.</h2>
    </div>

    <div class="audit-strip">
      <p>{siteConfig.auditStrip.headline}</p>
      <a class="btn btn-primary" href="#start">{siteConfig.auditStrip.ctaLabel}</a>
    </div>

    <div class="cycle-toggle" role="group" aria-label="Billing cycle">
      <button class="on" id="pt-monthly" type="button">Monthly</button>
      <button id="pt-annual" type="button">Annual &middot; save ~2 months</button>
    </div>

    <div class="tiers">
      {siteConfig.pricing.tiers.map((tier) => (
        <div class={`tier ${tier.featured ? "feat" : ""}`}>
          {tier.badge && <div class="badge">{tier.badge}</div>}
          <div class="tname">{tier.name}</div>
          <div class="ttag">{tier.tagline}</div>
          {tier.enquireOnly ? (
            <div class="tprice enq">Enquire</div>
          ) : (
            <div class="tprice" data-price-for={tier.id}>
              &euro;<span class="amount">{tier.monthlyEUR}</span>
              <small class="unit">/mo</small>
            </div>
          )}
          <div class="tsetup">{tier.setupNote}</div>
          {!tier.enquireOnly && (
            <div class="tannual-note" data-annual-note-for={tier.id} hidden>{siteConfig.pricing.annualSavingsNote}</div>
          )}
          <div class="tguarantee">30-day guarantee</div>
          <ul>
            {tier.featuresIntro && (
              <li>
                <span class="tick" set:html={tickSvg} />
                <b>{tier.featuresIntro}</b>
              </li>
            )}
            {tier.features.map((feature) => (
              <li>
                <span class="tick" set:html={tickSvg} />
                {feature}
              </li>
            ))}
          </ul>
          {tier.enquireOnly ? (
            <a class="btn btn-ghost" href="#start">Talk to us</a>
          ) : (
            <a
              class={`btn ${tier.featured ? "btn-primary" : "btn-ghost"}`}
              href={`/checkout?plan=${tier.id}`}
              data-cta-for={tier.id}
            >
              Choose {tier.name}
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<script define:vars={{ tierPriceData }}>
  function money(n) {
    return "€" + n.toLocaleString();
  }

  function renderCycle(cycle) {
    const isAnnual = cycle === "annual";
    document.querySelectorAll("[data-price-for]").forEach((el) => {
      const id = el.getAttribute("data-price-for");
      const prices = tierPriceData[id];
      if (!prices) return;
      const amount = isAnnual ? prices.annual : prices.monthly;
      el.querySelector(".amount").textContent = amount.toLocaleString();
      el.querySelector(".unit").textContent = isAnnual ? "/yr" : "/mo";
    });
    document.querySelectorAll("[data-annual-note-for]").forEach((el) => {
      el.hidden = !isAnnual;
    });
    document.querySelectorAll("[data-cta-for]").forEach((el) => {
      const id = el.getAttribute("data-cta-for");
      el.href = `/checkout?plan=${id}` + (isAnnual ? "&cycle=annual" : "");
    });
    document.getElementById("pt-monthly").classList.toggle("on", !isAnnual);
    document.getElementById("pt-annual").classList.toggle("on", isAnnual);
  }

  document.getElementById("pt-monthly").addEventListener("click", () => renderCycle("monthly"));
  document.getElementById("pt-annual").addEventListener("click", () => renderCycle("annual"));
</script>
