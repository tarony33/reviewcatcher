---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import StatsStrip from "../components/StatsStrip.astro";
import ProblemSection from "../components/ProblemSection.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import PricingTiers from "../components/PricingTiers.astro";
import Guarantee from "../components/Guarantee.astro";
import LeadForm from "../components/LeadForm.astro";
import FAQ from "../components/FAQ.astro";
import AuditPopup from "../components/AuditPopup.astro";
import { siteConfig } from "../config/site.config";

const description =
  "ReviewCatcher gets your happy customers to leave 5-star Google reviews automatically, and replies to every review. Automated review management for businesses across Ireland.";

const professionalServiceLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: siteConfig.name,
  url: siteConfig.url,
  description,
  email: siteConfig.contact.email,
  areaServed: { "@type": "Country", name: siteConfig.areaServed },
  slogan: siteConfig.tagline,
};

const faqPageLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: siteConfig.faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Layout
  title="ReviewCatcher | Get More Google Reviews — for Businesses Across Ireland"
  description={description}
  jsonLd={[professionalServiceLd, faqPageLd]}
>
  <Header />
  <main>
    <Hero />
    <StatsStrip />
    <ProblemSection />
    <HowItWorks />
    <FeatureGrid />
    <PricingTiers />
    <Guarantee />
    <LeadForm />
    <FAQ />
  </main>
  <AuditPopup />
</Layout>
