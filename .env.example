# Copy to .env for local dev (`astro dev` / `astro build` read this). In
# production these PUBLIC_ vars are set in the Cloudflare Pages project's
# build-time environment variables — never in the repo.
#
# Server-side secrets (STRIPE_SECRET_KEY, TURNSTILE_SECRET_KEY,
# N8N_LEAD_WEBHOOK_URL) are NOT here — Pages Functions read those from the
# Cloudflare runtime environment, not from this file. Locally that's
# `.dev.vars` (see .dev.vars.example) via `npm run preview:functions`.

# PUBLIC_ prefix required — rendered client-side by the Turnstile widget
# script in src/components/LeadForm.astro. Site keys are meant to be public,
# unlike the matching secret key.
PUBLIC_TURNSTILE_SITE_KEY=

PUBLIC_CF_BEACON_TOKEN=
