# Copy to .env for local dev. In production these live in the Cloudflare Pages
# project's environment variables — never in the repo.
# Note: STRIPE_SECRET_KEY specifically is read by functions/api/create-checkout-session.js
# (a Pages Function), so for local testing it goes in .dev.vars, not .env — see README.

STRIPE_SECRET_KEY=

# PUBLIC_ prefix required — this one is called directly from the browser
# (src/components/LeadForm.astro), so it ends up in the client bundle either
# way. Not a secret, just not meant to be spammed (Turnstile, below, is for that).
PUBLIC_N8N_LEAD_WEBHOOK_URL=

# Optional — layer these in whenever ready (build-spec-v2 §8). Nothing reads
# them yet.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
