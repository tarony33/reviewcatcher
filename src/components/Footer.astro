---
import { siteConfig } from "../config/site.config";
import { locations } from "../data/locations";

const legalLinks = [
  { href: "/privacy", label: "Privacy Policy" },
  { href: "/compliance", label: "Compliance Statement" },
  { href: "/ai-statement", label: "AI &amp; Automation Statement" },
  { href: "/complaints", label: "Complaints Procedure" },
  { href: "/dpa", label: "Data Processing (clients)" },
];

const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <div class="fgrid2">
      <div>
        <div class="logo">
          <svg width="26" height="26" viewBox="0 0 30 30" fill="none">
            <rect x="1" y="2" width="28" height="21" rx="7" fill="#fff" />
            <path d="M9 23l-3 5 8-4z" fill="#fff" />
            <g fill="#FFB800">
              <circle cx="9" cy="12" r="2" />
              <circle cx="15" cy="12" r="2.4" />
              <circle cx="21" cy="12" r="2" />
            </g>
          </svg>
          {siteConfig.name}
        </div>
        <p style="max-width:34ch">
          Automated Google reviews for businesses across {siteConfig.areaServed}. {siteConfig.tagline}
        </p>
      </div>
      <div>
        <h4>Legal</h4>
        {legalLinks.map((link) => <a href={link.href} set:html={link.label} />)}
      </div>
      <div>
        <h4>Contact</h4>
        <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
        <a href="/#start">Request a call</a>
        <a href="/blog">Blog</a>
      </div>
      <div>
        <h4>Areas we serve</h4>
        {locations.map((location) => (
          <a href={`/reviews-${location.slug}/`}>{location.name}</a>
        ))}
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} {siteConfig.name} &middot; Registered in Ireland &middot; {siteConfig.legal.registrationStatus}</span>
      <span>Data handled under GDPR &middot; Supervisory authority: dataprotection.ie</span>
    </div>
  </div>
</footer>
