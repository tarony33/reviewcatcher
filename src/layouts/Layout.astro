---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CloudflareAnalytics from "../components/CloudflareAnalytics.astro";
import { siteConfig } from "../config/site.config";

interface Props {
  title: string;
  description: string;
  /** Raw JSON-LD objects (LocalBusiness/ProfessionalService, FAQPage, etc.) to inject into <head>. */
  jsonLd?: Record<string, unknown>[];
  /** Checkout and similar focused flows skip the full sitewide footer. */
  hideFooter?: boolean;
}

const { title, description, jsonLd = [], hideFooter = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, siteConfig.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Figtree:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap"
      rel="stylesheet"
    />

    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <CloudflareAnalytics />
  </head>
  <body>
    <slot />
    {!hideFooter && <Footer />}
    <CookieConsent />
  </body>
</html>
