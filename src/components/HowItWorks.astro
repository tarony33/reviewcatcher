---
import { siteConfig } from "../config/site.config";
---

<section class="how" id="how">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow" style="color:var(--star)">How it works</span>
      <h2>The system you set up once, then forget.</h2>
      <p>Three steps to a steady flow of reviews running quietly in the background.</p>
    </div>
    <div class="steps">
      <div class="step">
        <div class="num">STEP 01</div>
        <h3>Connect</h3>
        <p>We link {siteConfig.name} to how you already work — your booking system, or a simple list. Every finished job or visit becomes a trigger.</p>
      </div>
      <div class="step">
        <div class="num">STEP 02</div>
        <h3>Launch</h3>
        <p>A friendly, personalised request goes out by text, branded as you. One tap takes your customer straight to your Google page.</p>
      </div>
      <div class="step">
        <div class="num">STEP 03</div>
        <h3>Automate</h3>
        <p>Gentle reminders catch the ones who forget, and every review gets a reply — automatically. You focus on the work; your reputation grows.</p>
      </div>
    </div>
    <div class="autoline">Every customer asked the same way. <b>No gating, no filtering — fully within Google's rules.</b></div>
  </div>
</section>
