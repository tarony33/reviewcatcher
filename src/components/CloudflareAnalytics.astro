---
// Cloudflare Web Analytics — cookieless, loads unconditionally (no consent
// gating needed). Set PUBLIC_CF_BEACON_TOKEN in the Cloudflare Pages project
// env vars (get the token from the Web Analytics dashboard after adding the site).
const token = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

{token && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={`{"token": "${token}"}`}
  />
)}
