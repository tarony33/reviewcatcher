---
import { siteConfig } from "../config/site.config";

const legalLinks = [
  { href: "/privacy", label: "Privacy" },
  { href: "/compliance", label: "Compliance" },
  { href: "/ai-statement", label: "AI Statement" },
  { href: "/complaints", label: "Complaints" },
  { href: "/contact", label: "Contact" },
  { href: "/dpa", label: "DPA" },
];
---

<footer class="border-t border-brand-light bg-white py-8 text-sm text-gray-600">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {new Date().getFullYear()} {siteConfig.name}. {siteConfig.contact.email}</p>
    <nav class="flex flex-wrap gap-x-4 gap-y-1">
      {legalLinks.map((link) => (
        <a href={link.href} class="hover:text-brand">{link.label}</a>
      ))}
    </nav>
  </div>
  <p class="mx-auto mt-4 max-w-5xl px-4 text-xs text-gray-400">
    We process personal data under GDPR. See our privacy policy and DPA for details.
  </p>
</footer>
